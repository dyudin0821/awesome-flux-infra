{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],

  "enabledManagers": ["flux", "custom.regex"],

  "flux": {
    "managerFilePatterns": [
      "/apps/base/.+\\.ya?ml$/",
      "/apps/bundles/[^/]+-flex/[^/]+\\.ya?ml$/",
      "/apps/bundles/[^/]+-minimal/[^/]+\\.ya?ml$/",
      "/clusters/.+\\.ya?ml$/"
    ]
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "CloudNative-PG Cluster imageName field",
      "managerFilePatterns": ["/clusters/.+/cluster\\.ya?ml$/"],
      "matchStrings": [
        "imageName:\\s+(?<depName>ghcr\\.io/cloudnative-pg/[^:]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "httpbin image tag",
      "managerFilePatterns": ["/apps/base/httpbin/helm-release\\.ya?ml$/"],
      "matchStrings": [
        "repository:\\s+(?<depName>docker\\.io/mccutchen/go-httpbin)\\s*\\n\\s*tag:\\s+\"?(?<currentValue>[^\\s\"]+)\"?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "oomkill-exporter image tag",
      "managerFilePatterns": ["/apps/base/oomkill-exporter/helm-release\\.ya?ml$/"],
      "matchStrings": [
        "repository:\\s+(?<depName>sapcc/kubernetes-oomkill-exporter)\\s*\\n\\s*tag:\\s+\"?(?<currentValue>[^\\s\"]+)\"?"
      ],
      "datasourceTemplate": "docker"
    }
  ],

  "timezone": "UTC",
  "minimumReleaseAge": "7 days",

  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,
  "semanticCommits": "enabled",
  "labels": ["renovate", "dependencies"],

  "packageRules": [
    {
      "description": "Observability stack — group minor+patch into one PR",
      "matchManagers": ["flux"],
      "matchPackageNames": [
        "victoria-metrics-k8s-stack",
        "victoria-logs-single",
        "grafana",
        "prometheus-blackbox-exporter",
        "helm-exporter",
        "x509-certificate-exporter",
        "k8s-event-logger",
        "kubelinks",
        "alloy",
        "loki",
        "metrics-server"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "observability (minor+patch)",
      "addLabels": ["observability"]
    },

    {
      "description": "Database operators — manual review required (CRD and schema changes)",
      "matchManagers": ["flux"],
      "matchPackageNames": [
        "cloudnative-pg",
        "altinity-clickhouse-operator",
        "eck-operator"
      ],
      "automerge": false,
      "addLabels": ["database", "needs-review"]
    },

    {
      "description": "Security components — manual review required",
      "matchManagers": ["flux"],
      "matchPackageNames": ["cert-manager", "external-secrets", "kyverno", "reflector"],
      "automerge": false,
      "addLabels": ["security"]
    },

    {
      "description": "Storage — manual review required (data loss risk)",
      "matchManagers": ["flux"],
      "matchPackageNames": ["longhorn", "seaweedfs"],
      "automerge": false,
      "addLabels": ["storage", "needs-review"]
    },

    {
      "description": "Networking — manual review for patch, dashboard approval for minor+",
      "matchManagers": ["flux"],
      "matchPackageNames": [
        "metallb",
        "envoy-gateway",
        "aws-load-balancer-controller",
        "external-dns"
      ],
      "automerge": false,
      "addLabels": ["networking"]
    },

    {
      "description": "Core infra — automerge patch updates",
      "matchManagers": ["flux"],
      "matchPackageNames": ["reloader", "keda"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },

    {
      "description": "CloudNative-PG images — major-only tags, always manual",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/cloudnative-pg/postgis"
      ],
      "automerge": false,
      "addLabels": ["database", "cnpg", "needs-review"]
    },

    {
      "description": "All major updates require dashboard approval",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-update"]
    }
  ]
}
